BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=8501

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Storage & Sandboxing
CLONE_STORAGE_DIR=.temp_repos
MAX_REPO_SIZE_MB=250
ANALYSIS_TIMEOUT_SECONDS=300
